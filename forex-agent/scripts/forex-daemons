#!/usr/bin/env bash
# forex-daemons — idempotent supervisor for the local forex services.
#
# Managed processes:
#   daemons   market_monitor signal_monitor position_monitor health_monitor
#             (python3 -m daemon.<name>)
#   services  local_api      loopback HTTP API + SSE event stream
#                            (python3 scripts/local_api.py --port $FOREX_API_PORT)
#             agent_bridge   persistent agent notification bridge:
#                            SSE -> host-agent sink
#                            (python3 -m agent.events.bridge)
#
# Usage:
#   forex-daemons start [name...]    start all (or named) daemons+services
#   forex-daemons stop [name...]     stop all (or named) daemons+services
#   forex-daemons restart [name...]  stop, start, then run the restart
#                                      safety sequence (state restore +
#                                      reconcile + health report)
#   forex-daemons status [name...]   show running state
#   forex-daemons health [--json]      aggregate health: daemon liveness +
#                                      kill-switch latch + broker_status +
#                                      event-journal tail
#   forex-daemons safety [--json]      run the restart safety sequence
#                                      standalone (no process changes)
#   forex-daemons prune                bounded event-journal pruning
#                                      (config: events.journal_retention_days
#                                      / events.journal_max_events)
#   forex-daemons logs [name...] [--lines N] [--follow]
#                                      tail service log files
#
# Idempotent: starting a running service is a no-op (exit 0); stopping a
# stopped service is a no-op (exit 0). Services are Python processes; each
# holds a PID file in $FOREX_AGENT_HOME/run/<name>.pid. Stale PID files
# (dead process) are reclaimed automatically.
#
# No duplicates: a flock(2) lock serializes every mutating command
# (start/stop/restart/prune/safety), and each service process re-checks
# its PID file at startup (daemon.common.acquire_pidfile) — a second
# launcher always loses and exits quietly, so two processes can never
# bind the same API port.
#
# Service independence: services are launched detached via setsid+nohup in
# their own session, so they survive the exit of whatever started them
# (agent process, shell, installer). An agent restart is NOT a forex
# restart — use `forex-daemons restart` (or the systemd units) to restart
# the forex subsystem itself.
#
# Environment:
#   FOREX_AGENT_HOME     agent home (default ~/.forex-agent)
#   FOREX_AGENT_STORAGE  sqlite path (default $FOREX_AGENT_HOME/storage/local.db)
#   FOREX_API_PORT       local API/SSE port (default 8765)
set -u

DAEMONS="market_monitor signal_monitor position_monitor health_monitor"
SERVICES="local_api agent_bridge"
ALL="$DAEMONS $SERVICES"
AGENT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HOME_DIR="${FOREX_AGENT_HOME:-$HOME/.forex-agent}"
RUN_DIR="$HOME_DIR/run"
LOG_DIR="$HOME_DIR/log"
PYTHON="${PYTHON:-python3}"
API_PORT="${FOREX_API_PORT:-8765}"
LOCK_FILE="$RUN_DIR/.supervisor.lock"

mkdir -p "$RUN_DIR" "$LOG_DIR"

# Serialize mutating commands so two concurrent invocations can never
# launch duplicate daemons or interleave stop/start.
with_lock() {
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        echo "another forex-daemons operation is in progress (lock $LOCK_FILE)" >&2
        exit 3
    fi
}

pid_of() {  # pid_of <daemon> -> prints pid or nothing
    local pidfile="$RUN_DIR/$1.pid"
    [ -f "$pidfile" ] || return 0
    local pid
    pid="$(tr -dc '0-9' < "$pidfile" 2>/dev/null)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && echo "$pid"
}

is_running() { [ -n "$(pid_of "$1")" ]; }

# service_argv <name>: set SERVICE_ARGV to the process argv for a managed
# daemon or service. Daemons are `python3 -m daemon.<name>`; the local API
# and the notification bridge have their own entry points.
service_argv() {
    case "$1" in
        local_api)    SERVICE_ARGV=("$PYTHON" "scripts/local_api.py"
                                   "--port" "$API_PORT") ;;
        agent_bridge) SERVICE_ARGV=("$PYTHON" "-m" "agent.events.bridge") ;;
        *)            SERVICE_ARGV=("$PYTHON" "-m" "daemon.$1") ;;
    esac
}

do_start_one() {
    local name="$1"
    if is_running "$name"; then
        echo "$name: already running (pid $(pid_of "$name"))"
        return 0
    fi
    # Reclaim a stale pidfile so the service can start cleanly.
    rm -f "$RUN_DIR/$name.pid"
    cd "$AGENT_ROOT" || return 1
    service_argv "$name"
    # setsid: the service gets its own session and survives the exit of
    # this script / the agent process that invoked it. nohup: immune to
    # SIGHUP. </dev/null: never hold the caller's stdin. 9>&-: never
    # inherit the supervisor lock (a service outliving the script must
    # not keep the lock held forever).
    FOREX_AGENT_HOME="$HOME_DIR" FOREX_AGENT_STORAGE="${FOREX_AGENT_STORAGE:-$HOME_DIR/storage/local.db}" \
        FOREX_API_PORT="$API_PORT" \
        setsid nohup "${SERVICE_ARGV[@]}" >> "$LOG_DIR/$name.log" 2>&1 < /dev/null 9>&- &
    # The service writes its own pidfile at startup (acquire_pidfile);
    # poll for it instead of trusting the launcher pid.
    local i=0
    while [ "$i" -lt 20 ]; do
        if is_running "$name"; then
            echo "$name: started (pid $(pid_of "$name"))"
            return 0
        fi
        sleep 0.5
        i=$((i + 1))
    done
    echo "$name: FAILED to start (see $LOG_DIR/$name.log)" >&2
    return 1
}

do_stop_one() {
    local name="$1"
    local pid
    pid="$(pid_of "$name")"
    if [ -z "$pid" ]; then
        rm -f "$RUN_DIR/$name.pid"
        echo "$name: not running"
        return 0
    fi
    kill "$pid" 2>/dev/null
    # Wait up to 10s for a clean exit (SIGTERM -> graceful shutdown).
    local i=0
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 10 ]; do
        sleep 1
        i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null
        echo "$name: force-killed (pid $pid)"
    else
        echo "$name: stopped"
    fi
    rm -f "$RUN_DIR/$name.pid"
    return 0
}

do_status_one() {
    local name="$1"
    local pid
    pid="$(pid_of "$name")"
    if [ -n "$pid" ]; then
        echo "$name: running (pid $pid)"
    elif [ -f "$RUN_DIR/$name.pid" ]; then
        echo "$name: stopped (stale pidfile)"
    else
        echo "$name: stopped"
    fi
}

do_health() {
    cd "$AGENT_ROOT" || return 1
    FOREX_AGENT_HOME="$HOME_DIR" FOREX_AGENT_STORAGE="${FOREX_AGENT_STORAGE:-$HOME_DIR/storage/local.db}" \
        "$PYTHON" -m daemon.supervisor health "$@"
}

do_safety() {
    cd "$AGENT_ROOT" || return 1
    FOREX_AGENT_HOME="$HOME_DIR" FOREX_AGENT_STORAGE="${FOREX_AGENT_STORAGE:-$HOME_DIR/storage/local.db}" \
        "$PYTHON" -m daemon.supervisor safety "$@"
}

do_prune() {
    cd "$AGENT_ROOT" || return 1
    FOREX_AGENT_HOME="$HOME_DIR" FOREX_AGENT_STORAGE="${FOREX_AGENT_STORAGE:-$HOME_DIR/storage/local.db}" \
        "$PYTHON" -m daemon.supervisor prune "$@"
}

do_logs() {
    local lines=50 follow="" names=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --lines) lines="$2"; shift 2 ;;
            --lines=*) lines="${1#--lines=}"; shift ;;
            --follow|-f) follow=1; shift ;;
            -*) echo "unknown option: $1" >&2; return 2 ;;
            *) names="$names $1"; shift ;;
        esac
    done
    [ -z "$names" ] && names="$ALL"
    local first=1
    for d in $names; do
        case " $ALL " in *" $d "*) ;; *) echo "unknown service: $d" >&2; return 2 ;; esac
        local log="$LOG_DIR/$d.log"
        [ "$first" = 1 ] || echo
        first=0
        echo "== $d ($log) =="
        if [ -f "$log" ]; then
            if [ -n "$follow" ]; then tail -n "$lines" -f "$log"; else tail -n "$lines" "$log"; fi
        else
            echo "(no log file yet)"
        fi
    done
}

resolve_targets() {
    if [ "$#" -eq 0 ]; then
        echo "$ALL"
        return 0
    fi
    local out=""
    for d in "$@"; do
        case " $ALL " in
            *" $d "*) out="$out $d" ;;
            *) echo "unknown service: $d (choose from: $ALL)" >&2; return 1 ;;
        esac
    done
    echo "$out"
}

cmd="${1:-status}"
shift || true

rc=0
case "$cmd" in
    start)
        with_lock
        targets="$(resolve_targets "$@")" || exit 2
        for d in $targets; do do_start_one "$d" || rc=1; done ;;
    stop)
        with_lock
        targets="$(resolve_targets "$@")" || exit 2
        for d in $targets; do do_stop_one "$d" || rc=1; done ;;
    restart)
        with_lock
        targets="$(resolve_targets "$@")" || exit 2
        for d in $targets; do do_stop_one "$d"; done
        for d in $targets; do do_start_one "$d" || rc=1; done
        # Restart safety sequence: restore/verify state, reconcile,
        # prune, and report health. Never trades.
        echo "--- restart safety sequence ---"
        do_safety || rc=1 ;;
    status)
        targets="$(resolve_targets "$@")" || exit 2
        for d in $targets; do do_status_one "$d"; done ;;
    health)
        do_health "$@" || rc=1 ;;
    safety)
        with_lock
        do_safety "$@" || rc=1 ;;
    prune)
        with_lock
        do_prune "$@" || rc=1 ;;
    logs)
        do_logs "$@" || rc=1 ;;
    *) echo "usage: $0 {start|stop|restart|status|health|safety|prune|logs} [daemon...]" >&2; exit 2 ;;
esac
exit "$rc"
